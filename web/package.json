{
  "name": "mitjul-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html public/sw.js scripts/*.mjs vite.config.ts"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.20.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
